---
import Base from '../layouts/Base.astro';
import {articles} from '../lib/data.js';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}))}
const {article}=Astro.props;
const siblings=articles.filter(a=>a.cluster===article.cluster&&a.slug!==article.slug).slice(0,8);
const origin='https://aherfsgroupbuy.com';
const canonical=origin+'/'+article.slug+'/';
const parent=articles.find(a=>a.slug===article.parentSlug);
const breadcrumbs=[
  {'@type':'ListItem',position:1,name:'Home',item:origin+'/'},
  ...(parent?[{'@type':'ListItem',position:2,name:article.cluster||parent.title,item:origin+'/'+parent.slug+'/'}]:[]),
  {'@type':'ListItem',position:parent?3:2,name:article.title,item:canonical}
];
const structuredData=[
 {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:breadcrumbs},
 {'@context':'https://schema.org','@type':article.isPillar?'WebPage':'Article',headline:article.title,description:article.seoDescription,url:canonical,inLanguage:'en',publisher:{'@type':'Organization',name:'AhrefsGroupBuy',url:origin}}
];
---
<Base title={article.seoTitle} description={article.seoDescription} pathname={'/'+article.slug+'/'} type="article" structuredData={structuredData}>
<section class="article-hero"><div class="container"><p class="eyebrow">{article.cluster} · Ahrefs knowledge base</p><h1>{article.title}</h1><p>{article.seoDescription}</p></div></section>
<div class="container article-shell"><aside class="article-toc"><h2>On this page</h2>{article.sections.map((s,i)=><a href={'#section-'+i}>{s.heading}</a>)}</aside><article class="article-content">{article.sections.map((s,i)=><section id={'section-'+i}><h2>{s.heading}</h2><div class="rich" set:html={s.html}/></section>)}</article><aside class="article-aside"><div class="help-card"><h3>Explore your options</h3><p>Compare plans, features and usage restrictions before deciding.</p><a class="btn" href="/#pricing">View pricing</a></div></aside></div>
<section class="container section"><h2>Related reading</h2><div class="cards">{siblings.map(a=><article class="card"><h3><a href={'/'+a.slug+'/'}>{a.title}</a></h3><p>{a.seoDescription}</p></article>)}</div></section>
</Base>
