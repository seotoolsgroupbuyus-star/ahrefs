---
import Base from '../layouts/Base.astro';
import {articles,site} from '../lib/data.js';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}))}
const {article}=Astro.props;
const siblings=articles.filter(a=>a.cluster===article.cluster&&a.slug!==article.slug).slice(0,8);
const origin=site.siteUrl.replace(/\/$/,'');
const canonical=origin+'/'+article.slug+'/';
const parent=articles.find(a=>a.slug===article.parentSlug);
const breadcrumbs=[
  {'@type':'ListItem',position:1,name:'Home',item:origin+'/'},
  ...(parent?[{'@type':'ListItem',position:2,name:article.cluster||parent.title,item:origin+'/'+parent.slug+'/'}]:[]),
  {'@type':'ListItem',position:parent?3:2,name:article.title,item:canonical}
];
const hash32=s=>{let h=0;for(let i=0;i<s.length;i++)h=(Math.imul(31,h)+s.charCodeAt(i))|0;return h>>>0;};
const defaultAuthor=site.contentAuthors?.length?site.contentAuthors[hash32(article.slug)%site.contentAuthors.length]:null;
const authorName=article.authorName||defaultAuthor?.name||'';
const authorRecord=site.contentAuthors?.find(a=>a.name===authorName)||defaultAuthor;
const dates={datePublished:article.datePublished||null,dateModified:article.dateModified||null};
const structuredData=[
 {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:breadcrumbs},
 {'@context':'https://schema.org','@type':article.isPillar?'WebPage':'Article',headline:article.title,description:article.seoDescription,url:canonical,inLanguage:'en',publisher:{'@type':'Organization',name:site.brand,url:origin},...(dates.datePublished?{datePublished:dates.datePublished}:{}),...(dates.dateModified?{dateModified:dates.dateModified}:{}),...(authorName?{author:{'@type':'Person',name:authorName}}:{})}
];
---
<Base title={article.seoTitle} description={article.seoDescription} pathname={'/'+article.slug+'/'} type="article" structuredData={structuredData}>
<section class="article-hero"><div class="container"><p class="eyebrow">{article.cluster} · {site.uiLabels.articleCategorySuffix}</p><h1>{article.title}</h1><p>{article.seoDescription}</p>{(authorName||dates.datePublished||dates.dateModified)&&<p class="article-meta">{authorName&&<span>{site.uiLabels.bylineLabel} {authorName}</span>}{dates.datePublished&&<span>{site.uiLabels.publishedLabel} <time datetime={dates.datePublished}>{dates.datePublished}</time></span>}{dates.dateModified&&<span>{site.uiLabels.updatedLabel} <time datetime={dates.dateModified}>{dates.dateModified}</time></span>}</p>}</div></section>
<div class="container article-shell"><article class="article-content">{article.sections.map((s,i)=><section id={'section-'+i}><h2>{s.heading}</h2><div class="rich" set:html={s.html}/></section>)}{authorName&&<aside class="article-author" id="article-author"><span class="author-avatar" aria-hidden="true">{authorName.split(' ').map(part=>part[0]).slice(0,2).join('').toUpperCase()}</span><div class="author-info"><p class="author-editorial">{site.brand} · {site.uiLabels.authorEditorialLabel}</p><p class="author-written">{site.uiLabels.authorWrittenBy}</p><h2>{authorRecord?.url?<a href={authorRecord.url} rel="author noopener noreferrer" target="_blank">{authorName}</a>:authorName}</h2>{authorRecord?.jobTitle&&<p class="author-role">{authorRecord.jobTitle}</p>}{authorRecord?.bio&&<p>{authorRecord.bio}</p>}</div></aside>}</article><aside class="article-aside"><nav class="article-toc" aria-label={site.uiLabels.tableOfContentsTitle}><h2>{site.uiLabels.tableOfContentsTitle}</h2>{article.sections.map((s,i)=><a href={'#section-'+i}>{s.heading}</a>)}</nav><div class="help-card"><h3>{site.uiLabels.articleAsideTitle}</h3><p>{site.uiLabels.articleAsideDescription}</p><a class="btn" href="/#pricing">{site.uiLabels.articleAsideButton}</a></div></aside></div>
<section class="container section"><h2>{site.uiLabels.relatedReadingTitle}</h2><div class="cards">{siblings.map(a=><article class="card"><h3><a href={'/'+a.slug+'/'}>{a.title}</a></h3><p>{a.seoDescription}</p></article>)}</div></section>
</Base>
