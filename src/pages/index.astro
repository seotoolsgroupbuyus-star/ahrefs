---
import Base from '../layouts/Base.astro';
import {site,articles} from '../lib/data.js';
const pillars=articles.filter(a=>a.isPillar);
const allBundleTools=[...new Set(['Ahrefs',...(site.plans.find(p=>p.id==='power')?.tools||[])])];
const heroAccent=site.uiLabels.heroTitleAccent||'';
const heroAccentIndex=heroAccent?site.heroTitle.toLowerCase().lastIndexOf(heroAccent.toLowerCase()):-1;
const heroPrefix=heroAccentIndex>=0?site.heroTitle.slice(0,heroAccentIndex):site.heroTitle;
const heroHighlight=heroAccentIndex>=0?site.heroTitle.slice(heroAccentIndex):'';
const featureMap=Object.fromEntries((site.featureDescriptions||[]).map(x=>[x.name,x.description]));
const toolDomain=name=>({ahrefs:'ahrefs.com',semrush:'semrush.com','canva pro':'canva.com',canva:'canva.com',grammarly:'grammarly.com','moz pro':'moz.com',moz:'moz.com',spyfu:'spyfu.com',ubersuggest:'neilpatel.com',envato:'envato.com',wordai:'wordai.com',quillbot:'quillbot.com',discord:'discord.com','keyword tool':'keywordtool.io',indexification:'indexification.com',crello:'create.vista.com',picmonkey:'picmonkey.com',buzzsumo:'buzzsumo.com',woorank:'woorank.com'}[name.toLowerCase().trim()]||'');
const toolLogoKey=name=>({ 'canva pro':'canva','moz pro':'moz','semrush':'semrush','ahrefs':'ahrefs','envato':'envato','grammarly':'grammarly','spyfu':'spyfu','ubersuggest':'ubersuggest' }[name.toLowerCase()]||name.toLowerCase().replace(/[^a-z0-9]/g,''));
---
<Base title={site.homeTitle} description={site.homeDescription}>
  <section class="hero" id="hero"><div class="container hero-inner">
    <span class="eyebrow">{site.heroBadge}</span><h1>{heroPrefix}{heroHighlight&&<span class="hero-highlight">{heroHighlight}</span>}</h1><p>{site.heroDescription}</p>
    <div class="actions"><a class="btn" href={site.primaryCtaUrl}>{site.primaryCtaText}</a><a class="btn alt" href={site.secondaryCtaUrl}>{site.secondaryCtaText}</a></div>
    <div class="chips">{site.uiLabels.heroChips.map(t=><span>{t}</span>)}</div>
    <div class="hero-proof"><div class="avatar-stack">{site.heroAvatars?.map((src,i)=><img src={src} width="38" height="38" alt={`Illustrative customer avatar ${i+1}`}/>)}</div><p>{site.heroTrust}</p></div>
    <div class="trust-strip">{site.uiLabels.trustStrip.map(t=><span>{t}</span>)}</div>
    <div class="tool-strip"><strong>{site.uiLabels.toolStripHeading}</strong><div>{site.toolStrip?.map(t=><span>{t}</span>)}</div></div>
  </div></section>
  <section class="container section" id="pricing"><div class="section-heading"><span class="eyebrow">{site.homeCopy.pricingEyebrow}</span><h2>{site.homeCopy.pricingTitle}</h2><p>{site.homeCopy.pricingLead}</p></div>
    <div class="pricing-controls" data-pkr-rate={site.pkrRate} data-coupon-code={site.couponCode} data-copied-label={site.uiLabels.copiedCouponLabel} role="group" aria-label="Price display options"><label>{site.uiLabels.billingLabel} <select id="billing-mode"><option value="monthly">{site.uiLabels.monthlyLabel}</option><option value="yearly">{site.uiLabels.yearlyLabel}</option></select></label><label>{site.uiLabels.currencyLabel} <select id="currency-mode"><option value="usd">{site.uiLabels.usdLabel}</option><option value="pkr">{site.uiLabels.pkrLabel}</option></select></label></div>
    <div class="cards plans">{site.plans?.map(p=><article class:list={['card','plan',p.popular?'popular':'']}>
      {p.popular&&<span class="ribbon">{site.uiLabels.popularRibbon}</span>}
      <h3>{p.name}</h3><p>{p.description}</p>
      <div class="price-amount" data-monthly={p.monthlyUsd} data-yearly={p.yearlyUsdPerMonth}><span class="amount">${p.monthlyUsd}</span><small class="price-unit">/mo</small></div>
      <ul class="features">{p.features?.map(f=><li><span aria-hidden="true">✓</span><span>{f}<small>{featureMap[f]||''}</small></span></li>)}</ul>
      {p.tools?.length>0&&<details><summary>{site.uiLabels.includedToolsLabel} ({p.tools.length})</summary><p>{p.tools.join(' · ')}</p></details>}
      <a class="btn" href={p.buyUrl} rel="noopener noreferrer">{site.uiLabels.planButton}</a>
    </article>)}</div>
    <div class="comparison-launch"><button type="button" class="linklike" id="open-plan-comparison" aria-haspopup="dialog">{site.uiLabels.openDetailedComparison} <span aria-hidden="true">→</span></button></div>
    <dialog id="plan-comparison-dialog" class="tools-dialog" aria-labelledby="plan-comparison-heading">
      <div class="tools-dialog-head"><h2 id="plan-comparison-heading">{site.uiLabels.detailedComparisonTitle}</h2><form method="dialog"><button class="btn alt" type="submit">{site.uiLabels.detailedComparisonClose}</button></form></div>
      <div class="table-scroll"><table><thead><tr><th>{site.uiLabels.comparisonFeatureHeader}</th>{site.plans.map(p=><th scope="col">{p.name}</th>)}</tr></thead><tbody>
      {site.uiLabels.detailedComparisonFeatures.map(feature=><tr><th scope="row">{feature}</th>{site.plans.map(p=><td class="comparison-status" aria-label={p.features.some(f=>f.toLowerCase().includes(feature.toLowerCase().split('/')[0])||f.includes('Everything'))?'Included':'Not included'}>{p.features.some(f=>f.toLowerCase().includes(feature.toLowerCase().split('/')[0])||f.includes('Everything'))?'✓':'×'}</td>)}</tr>)}
      </tbody></table></div>
    </dialog>
    <p class="coupon">{site.homeCopy.offerLabel} · {site.homeCopy.offerText} · <strong>{site.couponCode}</strong> <button id="copy-coupon" type="button">{site.uiLabels.copyCouponLabel}</button></p>
    <div class="risk-panel">
      <div><span class="risk-badge">{site.uiLabels.riskBadge}</span><h3>{site.uiLabels.riskTitle}</h3><p>{site.uiLabels.riskDescription}</p><div class="risk-trust">{site.uiLabels.trustStrip.map(t=><span>{t}</span>)}</div></div>
      <div class="risk-yearly"><h4>{site.uiLabels.yearlyWhyTitle}</h4><p>{site.uiLabels.yearlyWhyDescription}</p><a href="/#limitations">{site.uiLabels.yearlyWhyLink} <span aria-hidden="true">→</span></a></div>
    </div>
    
  </section>
  <section class="section contrast" id="how-it-works"><div class="container"><span class="eyebrow">{site.homeCopy.whyEyebrow}</span><h2>{site.homeCopy.whyTitle}</h2><p>{site.homeCopy.whyDescription}</p><div class="cards two-cols"><article class="card"><h3>{site.homeCopy.problemTitle}</h3><ul>{site.problemBullets?.map(t=><li>{t}</li>)}</ul></article><article class="card"><h3>{site.homeCopy.solutionTitle}</h3><ul>{site.solutionBullets?.map(t=><li>{t}</li>)}</ul></article></div></div></section>
  <section class="container section" id="tools"><span class="eyebrow">{site.homeCopy.toolsEyebrow}</span><h2>{site.homeCopy.toolsTitle}</h2><p>{site.homeCopy.toolsDescription}</p><div class="cards tools-grid">{site.tools?.map(t=><div class="card tool-card" data-color={t.color}><div class="tool-icon"><img src={t.logo||'https://cdn.simpleicons.org/'+toolLogoKey(t.name)} alt={t.name+' logo'} data-tool-logo={t.name} data-favicon={toolDomain(t.name)?'https://www.google.com/s2/favicons?domain='+toolDomain(t.name)+'&sz=64':''} loading="lazy" decoding="async" referrerpolicy="no-referrer"/></div><h3>{t.name}</h3><p>{site.homeCopy.toolBadge}</p></div>)}</div>
    {allBundleTools.length>0&&<div class="tools-modal-launch"><button type="button" class="btn" id="show-all-tools" aria-haspopup="dialog">{site.uiLabels.viewAllTools}</button></div>}
    <dialog class="tools-dialog" id="all-tools-dialog" aria-labelledby="all-tools-heading">
      <div class="tools-dialog-head"><div><h2 id="all-tools-heading">{site.uiLabels.allToolsTitle}</h2><p>{site.uiLabels.allToolsDescription}</p></div><form method="dialog"><button type="submit" class="btn alt close-dialog">{site.uiLabels.closeModal}</button></form></div>
      <div class="tools-search"><input id="tools-search-input" type="search" autocomplete="off" placeholder={site.uiLabels.toolsSearchPlaceholder} aria-label={site.uiLabels.toolsSearchPlaceholder}/></div>
      <ul class="all-tools-list search-tools-list">{allBundleTools.map(tool=><li data-tool-name={tool.toLowerCase()}><span class="tool-result-logo"><img src={'https://cdn.simpleicons.org/'+toolLogoKey(tool)} loading="lazy" decoding="async" alt={tool+' logo'} data-tool-logo={tool} data-favicon={toolDomain(tool)?'https://www.google.com/s2/favicons?domain='+toolDomain(tool)+'&sz=64':''}/></span><span>{tool}</span></li>)}</ul>
    </dialog>
  </section>
  <section class="section contrast" id="comparison"><div class="container"><h2>{site.homeCopy.comparisonTitle}</h2><div class="comparison-mobile">{site.comparison?.map(r=><article class="comparison-mobile-card"><h3>{r.feature}</h3><div class="comparison-buy"><strong>{site.uiLabels.comparisonGroupBuyHeader}</strong><p>{r.groupBuy}</p></div><div class="comparison-direct"><strong>{site.uiLabels.comparisonDirectHeader}</strong><p>{r.direct}</p></div></article>)}</div><div class="table-scroll comparison-desktop"><table><caption>{site.uiLabels.comparisonCaption}</caption><thead><tr><th>{site.uiLabels.comparisonFeatureHeader}</th><th>{site.uiLabels.comparisonGroupBuyHeader}</th><th>{site.uiLabels.comparisonDirectHeader}</th></tr></thead><tbody>{site.comparison?.map(r=><tr><th scope="row">{r.feature}</th><td>{r.groupBuy}</td><td>{r.direct}</td></tr>)}</tbody></table></div><div class="comparison-foot"><p class="muted">{site.homeCopy.comparisonHint}</p><a href="/#pricing">{site.uiLabels.seePricing} →</a></div></div></section>
  <section class="container section" id="toolbar"><span class="eyebrow">{site.homeCopy.extensionEyebrow}</span><h2>{site.homeCopy.extensionTitle}</h2><p>{site.homeCopy.extensionDescription}</p><div class="toolbar-layout"><div><div class="cards two-cols toolbar-features">{site.extensionFeatures?.map(t=><div class="card"><h3>{t.title}</h3><p>{t.description}</p></div>)}</div><div class="toolbar-cta"><a class="btn toolbar-main-cta" href={site.paymentBaseUrl} rel="noopener noreferrer">{site.uiLabels.toolbarButton} <span aria-hidden="true">→</span></a><div class="toolbar-proof"><div class="avatar-stack">{site.heroAvatars?.slice(0,4).map((src,i)=><img src={src} width="40" height="40" alt={'Illustrative SEO user '+(i+1)}/>)}</div><span>{site.uiLabels.toolbarSocialProof}</span></div></div></div>
      <div class="toolbar-browser" aria-label="Illustrative Ahrefs toolbar preview"><div class="browser-head"><span class="browser-dots"><i></i><i></i><i></i></span><span class="browser-url">{site.uiLabels.toolbarMockUrl}</span></div><div class="browser-content">{[1,2,3].map(i=><div class="browser-result"><div class="browser-title-skeleton"></div><div class="browser-line"></div><div class="browser-line short"></div><div class="browser-metrics">{site.uiLabels.toolbarMockMetrics.map((metric,j)=><span class:list={['metric','metric-'+j]}>{metric}</span>)}</div></div>)}</div></div></div></section>
  <section class="section contrast" id="limitations"><div class="container"><span class="eyebrow">{site.homeCopy.limitationsEyebrow}</span><h2>{site.homeCopy.limitationsTitle}</h2><p>{site.homeCopy.limitationsDescription}</p><div class="cards four-cols">{site.limitations?.map(l=><article class="card"><h3>{l.title}</h3><p>{l.desc}</p><strong>{l.limitLabel}</strong></article>)}</div><p><a href={site.whatsappUrl} rel="noopener noreferrer">{site.uiLabels.whatsappSupport}</a></p></div></section>
  <section class="container section" id="reviews"><span class="eyebrow">{site.homeCopy.reviewsEyebrow}</span><h2>{site.homeCopy.reviewsTitle}</h2><p>{site.homeCopy.reviewsCount}</p><div class="cards reviews-grid">{site.reviews?.map(r=><article class="card review"><div class="review-person"><img src={r.avatar} alt={`${r.name} illustrative profile`} width="45" height="45"/><div><h3>{r.name}</h3><small>{r.role}</small></div></div><p>“{r.content}”</p><small>{r.date}</small></article>)}</div></section>
  <section class="section contrast" id="faq"><div class="container faq-wrap"><h2>{site.homeCopy.faqTitle}</h2><p>{site.homeCopy.faqLead}</p>{site.faq?.map((f,i)=><details class="faq" open={i===0}><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></section>
  <section class="container section" id="guides"><h2>{site.homeCopy.guidesTitle}</h2><div class="cards">{pillars.map(a=><article class="card"><span class="eyebrow">{a.cluster}</span><h3><a href={'/'+a.slug+'/'}>{a.title}</a></h3><p>{a.seoDescription}</p><a href={'/'+a.slug+'/'}>{site.homeCopy.guidesLabel}</a></article>)}</div></section>
  <script is:inline>
    (()=>{document.querySelectorAll('img[data-tool-logo]').forEach(img=>{img.addEventListener('error',()=>{if(img.dataset.logoStage!=='favicon'&&img.dataset.favicon){img.dataset.logoStage='favicon';img.src=img.dataset.favicon;return}const fallback=document.createElement('span');fallback.className='logo-initials';fallback.textContent=(img.dataset.toolLogo||'').split(/\s+/).slice(0,2).map(w=>w.charAt(0).toUpperCase()).join('')||'?';img.replaceWith(fallback)})});document.getElementById('tools-search-input')?.addEventListener('input',e=>{const q=e.target.value.trim().toLowerCase();document.querySelectorAll('.search-tools-list [data-tool-name]').forEach(item=>{item.hidden=!item.dataset.toolName.includes(q)})});const planCompare=document.getElementById('plan-comparison-dialog');document.getElementById('open-plan-comparison')?.addEventListener('click',()=>planCompare?.showModal());planCompare?.addEventListener('click',e=>{if(e.target===planCompare)planCompare.close()});const allTools=document.getElementById('all-tools-dialog');document.getElementById('show-all-tools')?.addEventListener('click',()=>allTools?.showModal());allTools?.addEventListener('click',e=>{if(e.target===allTools)allTools.close()});const billing=document.getElementById('billing-mode'),currency=document.getElementById('currency-mode');const update=()=>{document.querySelectorAll('.price-amount').forEach(el=>{const annual=billing.value==='yearly';let n=Number(el.dataset[annual?'yearly':'monthly'])*(annual?12:1);if(currency.value==='pkr')n=Math.round(n*Number(document.querySelector('.pricing-controls')?.dataset.pkrRate||280));el.querySelector('.amount').textContent=(currency.value==='pkr'?'Rs ':'$')+n.toLocaleString();el.querySelector('.price-unit').textContent=annual?'/yr':'/mo'})};billing?.addEventListener('change',update);currency?.addEventListener('change',update);update();document.getElementById('copy-coupon')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('.pricing-controls')?.dataset.couponCode||'');document.getElementById('copy-coupon').textContent=document.querySelector('.pricing-controls')?.dataset.copiedLabel||'Copied'}catch{}})})();
  </script>
</Base>