---
import Base from '../layouts/Base.astro';
import {site,articles} from '../lib/data.js';
const pillars=articles.filter(a=>a.isPillar);
const toolLogoKey=name=>({ 'canva pro':'canva','moz pro':'moz','semrush':'semrush','ahrefs':'ahrefs','envato':'envato','grammarly':'grammarly','spyfu':'spyfu','ubersuggest':'ubersuggest' }[name.toLowerCase()]||name.toLowerCase().replace(/[^a-z0-9]/g,''));
const featureMap={
  'Ahrefs SEO Toolbar':'Browser-based metrics (DR/UR) and quick checks while you browse.',
  'SERP Metrics (DR/UR)':'Show authority-style metrics directly on search results pages.',
  '30 Credits / Day':'Daily quota to keep shared access stable across all members.',
  'Keywords Explorer':'Keyword ideas + volume/difficulty style metrics for planning.',
};
---
<Base title={site.homeTitle} description={site.homeDescription}>
  <section class="hero" id="hero"><div class="container hero-inner">
    <span class="eyebrow">{site.heroBadge}</span><h1>{site.heroTitle}</h1><p>{site.heroDescription}</p>
    <div class="actions"><a class="btn" href={site.primaryCtaUrl}>{site.primaryCtaText}</a><a class="btn alt" href={site.secondaryCtaUrl}>{site.secondaryCtaText}</a></div>
    <div class="chips">{['Official Data','Instant Setup','Private Projects'].map(t=><span>{t}</span>)}</div>
    <div class="hero-proof"><div class="avatar-stack">{site.heroAvatars?.map((src,i)=><img src={src} width="38" height="38" alt={`Illustrative customer avatar ${i+1}`}/>)}</div><p>{site.heroTrust}</p></div>
    <div class="trust-strip"><span>✓ SSL Secure</span><span>✓ Encrypted Payment</span><span>✓ Verified Access</span></div>
    <div class="tool-strip"><strong>Included in your AhrefsGroupBuy access</strong><div>{site.toolStrip?.map(t=><span>{t}</span>)}</div></div>
  </div></section>
  <section class="container section" id="pricing"><div class="section-heading"><span class="eyebrow">Choose Your Plan</span><h2>Pricing That Fits Your Budget</h2><p>Choose the perfect plan for your SEO needs. From individual bloggers to large agencies, we've got you covered.</p></div>
    <div class="pricing-controls" data-pkr-rate={site.pkrRate} data-coupon-code={site.couponCode} role="group" aria-label="Price display options"><label>Billing <select id="billing-mode"><option value="monthly">Monthly</option><option value="yearly">Yearly -20%</option></select></label><label>Currency <select id="currency-mode"><option value="usd">USD</option><option value="pkr">PKR</option></select></label></div>
    <div class="cards plans">{site.plans?.map(p=><article class:list={['card','plan',p.popular?'popular':'']}>
      {p.popular&&<span class="ribbon">Recommended for you</span>}
      <h3>{p.name}</h3><p>{p.description}</p>
      <div class="price-amount" data-monthly={p.monthlyUsd} data-yearly={p.yearlyUsdPerMonth}><span class="amount">${p.monthlyUsd}</span><small class="price-unit">/mo</small></div>
      <ul class="features">{p.features?.map(f=><li><span aria-hidden="true">✓</span><span>{f}<small>{featureMap[f]||''}</small></span></li>)}</ul>
      {p.tools?.length>0&&<details><summary>Included tools ({p.tools.length})</summary><p>{p.tools.join(' · ')}</p></details>}
      <a class="btn" href={p.buyUrl} rel="noopener noreferrer">Get Started</a>
    </article>)}</div>
    <p class="coupon">Limited Time Offer · Get extra 20% off on your first month · <strong>{site.couponCode}</strong> <button id="copy-coupon" type="button">Copy Code</button></p>
    <p class="muted">Checkout URLs and promotional claims are preserved from the supplied Next.js source; validate them before launch.</p>
  </section>
  <section class="section contrast" id="how-it-works"><div class="container"><span class="eyebrow">Why Choose Shared Access?</span><h2>Why Choose Shared Access?</h2><p>Traditional tool subscriptions are designed for big agencies. We make them accessible for everyone.</p><div class="cards two-cols"><article class="card"><h3>The Problem</h3><ul>{site.problemBullets?.map(t=><li>{t}</li>)}</ul></article><article class="card"><h3>The Solution</h3><ul>{site.solutionBullets?.map(t=><li>{t}</li>)}</ul></article></div></div></section>
  <section class="container section" id="tools"><span class="eyebrow">Premium tools</span><h2>Get Instant Access to 20+ Premium SEO Tools</h2><p>Everything you need for SEO, Content, and Design in one place.</p><div class="cards tools-grid">{site.tools?.map(t=><div class="card tool-card"><div class="tool-icon"><img src={'https://cdn.simpleicons.org/'+toolLogoKey(t.name)} alt={t.name+' logo'} loading="lazy" decoding="async" referrerpolicy="no-referrer"/></div><h3>{t.name}</h3><p>Premium Access</p></div>)}</div></section>
  <section class="section contrast" id="comparison"><div class="container"><h2>Official Ahrefs vs AhrefsGroupBuy: The Price Gap</h2><div class="table-scroll"><table><caption>Source website comparison data</caption><thead><tr><th>Feature</th><th>AhrefsGroupBuy (Group Buy)</th><th>Ahrefs Direct</th></tr></thead><tbody>{site.comparison?.map(r=><tr><th scope="row">{r.feature}</th><td>{r.groupBuy}</td><td>{r.direct}</td></tr>)}</tbody></table></div><p class="muted">Tip: Use this table to match the plan to your budget and workflow.</p></div></section>
  <section class="container section" id="toolbar"><span class="eyebrow">Exclusive Extension Access</span><h2>Use Ahrefs SEO Toolbar Directly in Your Browser</h2><p>Stop switching tabs. Get critical SEO metrics like Domain Rating, URL Rating, and Backlink counts directly on Google SERPs and any website you visit.</p><div class="cards four-cols">{['SERP Overview','Domain Metrics','Keyword Difficulty','Quick Analysis'].map((t,i)=><div class="card"><h3>{t}</h3><p>{['Get DR, UR, and Backlink counts directly on Google search results.','Check any website’s strength without leaving the page.','Instantly see how hard it is to rank for any search term.','One-click access to full Site Explorer reports.'][i]}</p></div>)}</div></section>
  <section class="section contrast" id="limitations"><div class="container"><span class="eyebrow">Transparency First</span><h2>Transparent Limitations — We Keep it Honest</h2><p>We believe in being 100% honest with our users. To maintain the highest stability and lowest prices, we have a few common-sense rules.</p><div class="cards four-cols">{site.limitations?.map(l=><article class="card"><h3>{l.title}</h3><p>{l.desc}</p><strong>{l.limitLabel}</strong></article>)}</div><p><a href={site.whatsappUrl} rel="noopener noreferrer">WhatsApp support</a></p></div></section>
  <section class="container section" id="reviews"><span class="eyebrow">Success Stories</span><h2>What Our Users Say About Us</h2><p>Based on 1,428 reviews — source-site claim, not independently verified.</p><div class="cards reviews-grid">{site.reviews?.map(r=><article class="card review"><div class="review-person"><img src={r.avatar} alt={`${r.name} illustrative profile`} width="45" height="45"/><div><h3>{r.name}</h3><small>{r.role}</small></div></div><p>“{r.content}”</p><small>{r.date}</small></article>)}</div></section>
  <section class="section contrast" id="faq"><div class="container faq-wrap"><h2>Ahrefs Group Buy — Frequently Asked Questions</h2><p>Everything you need to know about our Ahrefs access.</p>{site.faq?.map((f,i)=><details class="faq" open={i===0}><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></section>
  <section class="container section" id="guides"><h2>Ahrefs guides & comparisons</h2><div class="cards">{pillars.map(a=><article class="card"><span class="eyebrow">{a.cluster}</span><h3><a href={'/'+a.slug+'/'}>{a.title}</a></h3><p>{a.seoDescription}</p><a href={'/'+a.slug+'/'}>Read guide</a></article>)}</div></section>
  <script is:inline>
    (()=>{const billing=document.getElementById('billing-mode'),currency=document.getElementById('currency-mode');const update=()=>{document.querySelectorAll('.price-amount').forEach(el=>{const annual=billing.value==='yearly';let n=Number(el.dataset[annual?'yearly':'monthly'])*(annual?12:1);if(currency.value==='pkr')n=Math.round(n*Number(document.querySelector('.pricing-controls')?.dataset.pkrRate||280));el.querySelector('.amount').textContent=(currency.value==='pkr'?'Rs ':'$')+n.toLocaleString();el.querySelector('.price-unit').textContent=annual?'/yr':'/mo'})};billing?.addEventListener('change',update);currency?.addEventListener('change',update);update();document.getElementById('copy-coupon')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('.pricing-controls')?.dataset.couponCode||'');document.getElementById('copy-coupon').textContent='Copied'}catch{}})})();
  </script>
</Base>