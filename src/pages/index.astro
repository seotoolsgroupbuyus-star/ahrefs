---
import Base from '../layouts/Base.astro';
import {site,articles} from '../lib/data.js';
const pillars=articles.filter(a=>a.isPillar);
const featureMap=Object.fromEntries((site.featureDescriptions||[]).map(x=>[x.name,x.description]));
const toolLogoKey=name=>({ 'canva pro':'canva','moz pro':'moz','semrush':'semrush','ahrefs':'ahrefs','envato':'envato','grammarly':'grammarly','spyfu':'spyfu','ubersuggest':'ubersuggest' }[name.toLowerCase()]||name.toLowerCase().replace(/[^a-z0-9]/g,''));
---
<Base title={site.homeTitle} description={site.homeDescription}>
  <section class="hero" id="hero"><div class="container hero-inner">
    <span class="eyebrow">{site.heroBadge}</span><h1>{site.heroTitle}</h1><p>{site.heroDescription}</p>
    <div class="actions"><a class="btn" href={site.primaryCtaUrl}>{site.primaryCtaText}</a><a class="btn alt" href={site.secondaryCtaUrl}>{site.secondaryCtaText}</a></div>
    <div class="chips">{['Official Data','Instant Setup','Private Projects'].map(t=><span>{t}</span>)}</div>
    <div class="hero-proof"><div class="avatar-stack">{site.heroAvatars?.map((src,i)=><img src={src} width="38" height="38" alt={`Illustrative customer avatar ${i+1}`}/>)}</div><p>{site.heroTrust}</p></div>
    <div class="trust-strip"><span>✓ SSL Secure</span><span>✓ Encrypted Payment</span><span>✓ Verified Access</span></div>
    <div class="tool-strip"><strong>Included in your AhrefsGroupBuy access</strong><div>{site.toolStrip?.map(t=><span>{t}</span>)}</div></div>
  </div></section>
  <section class="container section" id="pricing"><div class="section-heading"><span class="eyebrow">{site.homeCopy.pricingEyebrow}</span><h2>{site.homeCopy.pricingTitle}</h2><p>{site.homeCopy.pricingLead}</p></div>
    <div class="pricing-controls" data-pkr-rate={site.pkrRate} data-coupon-code={site.couponCode} role="group" aria-label="Price display options"><label>Billing <select id="billing-mode"><option value="monthly">Monthly</option><option value="yearly">Yearly -20%</option></select></label><label>Currency <select id="currency-mode"><option value="usd">USD</option><option value="pkr">PKR</option></select></label></div>
    <div class="cards plans">{site.plans?.map(p=><article class:list={['card','plan',p.popular?'popular':'']}>
      {p.popular&&<span class="ribbon">Recommended for you</span>}
      <h3>{p.name}</h3><p>{p.description}</p>
      <div class="price-amount" data-monthly={p.monthlyUsd} data-yearly={p.yearlyUsdPerMonth}><span class="amount">${p.monthlyUsd}</span><small class="price-unit">/mo</small></div>
      <ul class="features">{p.features?.map(f=><li><span aria-hidden="true">✓</span><span>{f}<small>{featureMap[f]||''}</small></span></li>)}</ul>
      {p.tools?.length>0&&<details><summary>Included tools ({p.tools.length})</summary><p>{p.tools.join(' · ')}</p></details>}
      <a class="btn" href={p.buyUrl} rel="noopener noreferrer">Get Started</a>
    </article>)}</div>
    <p class="coupon">{site.homeCopy.offerLabel} · {site.homeCopy.offerText} · <strong>{site.couponCode}</strong> <button id="copy-coupon" type="button">Copy Code</button></p>
    <p class="muted">Checkout URLs and promotional claims are preserved from the supplied Next.js source; validate them before launch.</p>
  </section>
  <section class="section contrast" id="how-it-works"><div class="container"><span class="eyebrow">{site.homeCopy.whyEyebrow}</span><h2>{site.homeCopy.whyTitle}</h2><p>{site.homeCopy.whyDescription}</p><div class="cards two-cols"><article class="card"><h3>{site.homeCopy.problemTitle}</h3><ul>{site.problemBullets?.map(t=><li>{t}</li>)}</ul></article><article class="card"><h3>{site.homeCopy.solutionTitle}</h3><ul>{site.solutionBullets?.map(t=><li>{t}</li>)}</ul></article></div></div></section>
  <section class="container section" id="tools"><span class="eyebrow">{site.homeCopy.toolsEyebrow}</span><h2>{site.homeCopy.toolsTitle}</h2><p>{site.homeCopy.toolsDescription}</p><div class="cards tools-grid">{site.tools?.map(t=><div class="card tool-card"><div class="tool-icon"><img src={'https://cdn.simpleicons.org/'+toolLogoKey(t.name)} alt={t.name+' logo'} loading="lazy" decoding="async" referrerpolicy="no-referrer"/></div><h3>{t.name}</h3><p>{site.homeCopy.toolBadge}</p></div>)}</div></section>
  <section class="section contrast" id="comparison"><div class="container"><h2>{site.homeCopy.comparisonTitle}</h2><div class="table-scroll"><table><caption>Source website comparison data</caption><thead><tr><th>Feature</th><th>AhrefsGroupBuy (Group Buy)</th><th>Ahrefs Direct</th></tr></thead><tbody>{site.comparison?.map(r=><tr><th scope="row">{r.feature}</th><td>{r.groupBuy}</td><td>{r.direct}</td></tr>)}</tbody></table></div><p class="muted">Tip: Use this table to match the plan to your budget and workflow.</p></div></section>
  <section class="container section" id="toolbar"><span class="eyebrow">{site.homeCopy.extensionEyebrow}</span><h2>{site.homeCopy.extensionTitle}</h2><p>{site.homeCopy.extensionDescription}</p><div class="cards four-cols">{site.extensionFeatures?.map(t=><div class="card"><h3>{t.title}</h3><p>{t.description}</p></div>)}</div></section>
  <section class="section contrast" id="limitations"><div class="container"><span class="eyebrow">{site.homeCopy.limitationsEyebrow}</span><h2>{site.homeCopy.limitationsTitle}</h2><p>{site.homeCopy.limitationsDescription}</p><div class="cards four-cols">{site.limitations?.map(l=><article class="card"><h3>{l.title}</h3><p>{l.desc}</p><strong>{l.limitLabel}</strong></article>)}</div><p><a href={site.whatsappUrl} rel="noopener noreferrer">WhatsApp support</a></p></div></section>
  <section class="container section" id="reviews"><span class="eyebrow">{site.homeCopy.reviewsEyebrow}</span><h2>{site.homeCopy.reviewsTitle}</h2><p>{site.homeCopy.reviewsCount} — source-site claim, not independently verified.</p><div class="cards reviews-grid">{site.reviews?.map(r=><article class="card review"><div class="review-person"><img src={r.avatar} alt={`${r.name} illustrative profile`} width="45" height="45"/><div><h3>{r.name}</h3><small>{r.role}</small></div></div><p>“{r.content}”</p><small>{r.date}</small></article>)}</div></section>
  <section class="section contrast" id="faq"><div class="container faq-wrap"><h2>{site.homeCopy.faqTitle}</h2><p>{site.homeCopy.faqLead}</p>{site.faq?.map((f,i)=><details class="faq" open={i===0}><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></section>
  <section class="container section" id="guides"><h2>{site.homeCopy.guidesTitle}</h2><div class="cards">{pillars.map(a=><article class="card"><span class="eyebrow">{a.cluster}</span><h3><a href={'/'+a.slug+'/'}>{a.title}</a></h3><p>{a.seoDescription}</p><a href={'/'+a.slug+'/'}>{site.homeCopy.guidesLabel}</a></article>)}</div></section>
  <script is:inline>
    (()=>{const billing=document.getElementById('billing-mode'),currency=document.getElementById('currency-mode');const update=()=>{document.querySelectorAll('.price-amount').forEach(el=>{const annual=billing.value==='yearly';let n=Number(el.dataset[annual?'yearly':'monthly'])*(annual?12:1);if(currency.value==='pkr')n=Math.round(n*Number(document.querySelector('.pricing-controls')?.dataset.pkrRate||280));el.querySelector('.amount').textContent=(currency.value==='pkr'?'Rs ':'$')+n.toLocaleString();el.querySelector('.price-unit').textContent=annual?'/yr':'/mo'})};billing?.addEventListener('change',update);currency?.addEventListener('change',update);update();document.getElementById('copy-coupon')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector('.pricing-controls')?.dataset.couponCode||'');document.getElementById('copy-coupon').textContent='Copied'}catch{}})})();
  </script>
</Base>